# Backend selector: "mongo" (default) or "postgres"
STAKEOUT_BACKEND=mongo

# MongoDB connection (used when STAKEOUT_BACKEND=mongo)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=stakeout

# PostgreSQL connection (used when STAKEOUT_BACKEND=postgres)
# Either variable is accepted; POSTGRES_URI takes precedence
POSTGRES_URI=postgresql://localhost/stakeout
# DATABASE_URL=postgresql://localhost/stakeout

# API server port
PORT=3001

# Authentication (leave unset to disable auth — suitable for local dev)
# Basic auth: set both USER and PASSWORD
# STAKEOUT_DASHBOARD_USER=admin
# STAKEOUT_DASHBOARD_PASSWORD=changeme

# Bearer token: set TOKEN for programmatic / reverse-proxy access
# STAKEOUT_DASHBOARD_TOKEN=your-secret-token
